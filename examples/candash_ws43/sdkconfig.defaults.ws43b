# The ws43b (Waveshare ESP32-S3-Touch-LCD-4.3B), layered on sdkconfig.defaults by -DPOC_BOARD=ws43b. Its CAN has
# GPIO15/16 to itself and GPIO43/44 are RS485, so the console is native USB, as in CANDash's sdkconfig.defaults.ws43b.
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
