menu "udsota example"

    config EXAMPLE_CAN_TX_GPIO
        int "TWAI TX GPIO"
        default 4
        help
            GPIO wired to the CAN transceiver's TXD input.

    config EXAMPLE_CAN_RX_GPIO
        int "TWAI RX GPIO"
        default 5
        help
            GPIO wired to the CAN transceiver's RXD output.

    config EXAMPLE_CAN_BITRATE
        int "CAN bit rate (bit/s)"
        default 500000
        help
            The bus's bit rate; udsota needs no particular one.

endmenu
