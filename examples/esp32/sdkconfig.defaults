# 4 MB flash with two OTA slots and otadata (partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A new image boots pending verify and the client's ConfirmImage keeps it; a reset before that boots the old one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A 1 ms tick lets the diag task sleep exactly to its deadlines (the first 0x78 goes at 40 ms, inside P2's 50 ms).
CONFIG_FREERTOS_HZ=1000
